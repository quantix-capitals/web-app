{
  "name": "stealth-mode",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @stealth/web",
    "build": "npm run build --workspace @stealth/web",
    "preview": "npm run preview --workspace @stealth/web",
    "lint": "npm run lint --workspace @stealth/web",
    "typecheck": "npm run typecheck --workspace @stealth/web",
    "dev:agent": "npm run dev --workspace @stealth/agent"
  }
}
