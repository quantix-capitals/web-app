# Copy to .env.local and fill in from your Supabase project settings.
# Both of these ship to the browser — only ever the anon key here. RLS is what
# protects the rows; see supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the separately hosted agent service answers. Leave blank until it's up —
# the UI shows "Agent offline" and every page still renders.
NEXT_PUBLIC_AGENT_URL=
