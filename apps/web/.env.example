# Copy to .env.local and fill in from your Supabase project settings.
# Both of these ship to the browser — only ever the anon key here. RLS is what
# protects the rows; see supabase/migrations/0001_init.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the two edge functions answer. Leave blank in development: the Vite dev
# server proxies /functions/v1 to `supabase functions serve` on :54321. In a
# deploy, set it to https://<project-ref>.supabase.co/functions/v1.
VITE_FUNCTIONS_URL=

# Where the separately hosted agent service answers. Leave blank until it's up —
# the UI shows "Agent offline" and every page still renders.
VITE_AGENT_URL=

# The dev server is pinned to :3000 (see vite.config.ts) because Zerodha will
# only redirect back to the URL registered on the Kite app.
#
# Zerodha's Kite keys are NOT here. They live on the `zerodha` edge function
# (`supabase secrets set KITE_API_KEY=... KITE_API_SECRET=...`), because the
# secret signs the session checksum and a secret in a page is not a secret.

# --- LLM: the watchlist analyst -----------------------------------------------
#
# The basket sidebar's analysis agent runs on the OpenAI Agents SDK. For now it
# runs IN THE BROWSER, so `vite.config.ts` forwards these two into the bundle —
# which means the key ships inside the built JavaScript. Fine for a desk running
# its own build; not fine for a deploy. Moving the agent behind `apps/agent` is
# what turns this back into a server secret; see that README.
#
# Unprefixed on purpose: same names as the server would use, so the model is
# named in one place. The `VITE_`-prefixed spellings also work if you prefer them.
OPENAI_API_KEY=
# Optional. Defaults to the Agents SDK's own model.
AGENT_MODEL=

