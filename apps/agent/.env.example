# Copy to .env. Nothing here is public — this service is never called from a browser
# with these values exposed.

PORT=8787

# Same Supabase project the web app uses.
SUPABASE_URL=
# Service role: bypasses RLS. This key must never leave this service.
SUPABASE_SERVICE_ROLE_KEY=

# The model the agent reasons with.
ANTHROPIC_API_KEY=

# Market data vendor — whichever you settle on. Swap it in src/data/market.js.
MARKET_DATA_API_KEY=

# Origins allowed to call this service (the web app's URL, comma separated).
ALLOWED_ORIGINS=http://localhost:3000
